# ═══════════════════════════════════════════════════════════════════════════
#  ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════════════════
#
#  Copy this file to `.env.local` and fill in the real values:
#
#      cp .env.example .env.local
#
#  `.env.local` is gitignored. Never commit real keys.
#  On Vercel, add each of these under Project → Settings → Environment Variables.
#
#  The site BUILDS AND RUNS with none of these set — the contact form will
#  return a clear "email is not configured" error instead of crashing, and the
#  content layer falls back to the local files in `data/`. Fill them in when
#  you are ready to go live.
#
# ═══════════════════════════════════════════════════════════════════════════


# ── REQUIRED FOR THE CONTACT FORM ──────────────────────────────────────────

# Resend API key. Create one free at https://resend.com/api-keys
# Format: starts with "re_". Server-only — never exposed to the browser.
RESEND_API_KEY=

# The "from" address Resend sends as. The domain must be verified in Resend
# (https://resend.com/domains). For local testing you can use Resend's shared
# sandbox sender: onboarding@resend.dev
RESEND_FROM_EMAIL=Portfolio <hello@yourdomain.com>

# Where contact-form submissions are delivered — your real inbox.
CONTACT_TO_EMAIL=you@yourdomain.com


# ── REQUIRED FOR FORM SECURITY ─────────────────────────────────────────────

# Secret used to sign the double-submit CSRF token (HMAC-SHA256).
# Must be at least 32 characters of high-entropy randomness.
# Generate one with:  openssl rand -base64 32
CSRF_SECRET=


# ── SITE URL ───────────────────────────────────────────────────────────────

# Canonical production origin, no trailing slash. Used for canonical tags,
# Open Graph image URLs, sitemap.xml and robots.txt.
# Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://yourdomain.com


# ── OPTIONAL: SANITY CMS ───────────────────────────────────────────────────
#
#  Leave these BLANK to serve content from the typed local files in `data/`.
#  Set the project id + dataset and the content adapter in
#  `lib/content/index.ts` automatically switches to Sanity — no component
#  changes needed. Schemas are ready to deploy in `sanity/schemas/`.
#
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Read token — only needed if your dataset is PRIVATE. Public datasets work
# without it. Create at https://sanity.io/manage → API → Tokens (Viewer role).
SANITY_API_READ_TOKEN=


# ── OPTIONAL: NEWSLETTER ───────────────────────────────────────────────────

# Resend Audience id for newsletter signups (https://resend.com/audiences).
# If blank, signups are emailed to CONTACT_TO_EMAIL instead of being stored.
RESEND_AUDIENCE_ID=
