# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# NOTE: package-lock.json is deliberately NOT ignored. The lockfile must be
# committed so CI and Vercel install the exact dependency tree that was
# security-reviewed locally.

# ── Next.js build output ────────────────────────────────────────────────────
.next/
out/
build/
dist/
next-env.d.ts

# ── Runtime / cache ─────────────────────────────────────────────────────────
*.tsbuildinfo
.eslintcache
.turbo/
.swc/

# ── Environment variables (secrets) ─────────────────────────────────────────
# .env.example IS committed — it documents the required keys with no values.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# ── Logs ────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
*.log

# ── Testing / coverage ──────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Deployment ──────────────────────────────────────────────────────────────
.vercel

# ── Editor / OS noise ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~
